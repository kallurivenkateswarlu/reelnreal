# WordPress Configuration
# Copy this file to .env and fill in your values

# Content source: 'json' or 'wordpress'
CONTENT_SOURCE=wordpress

# WordPress API URL (with https://)
WP_API_URL=https://your-wordpress-domain.com

# WordPress REST API Authentication
# Option 1: Application Password (recommended)
WP_USERNAME=your_username
WP_APP_PASSWORD=your_app_password_here

# Option 2: Basic Auth (username:password in base64)
# WP_BASIC_AUTH=base64_encoded_credentials

# Development
NODE_ENV=development
DEBUG=false

# Netlify / Deployment
PUBLIC_WP_API_URL=https://your-wordpress-domain.com
